<?xml version="1.0" encoding="utf-8"?>
<!--
    Logo simples de "carteira", usada como marca d'água decorativa no fundo
    do cabeçalho (veja bg_header.xml). Cor já vem com alfa baixo embutido no
    próprio path, então o desenho funciona como um detalhe sutil, não como
    um ícone chamativo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Corpo da carteira -->
    <path
        android:fillColor="#26FFFFFF"
        android:pathData="M5,6 H19 A2,2 0 0 1 21,8 V16 A2,2 0 0 1 19,18 H5 A2,2 0 0 1 3,16 V8 A2,2 0 0 1 5,6 Z" />

    <!-- Linha da aba -->
    <path
        android:fillColor="#26FFFFFF"
        android:pathData="M3,9.4 H21 V9.8 H3 Z" />

    <!-- Botão/fecho -->
    <path
        android:fillColor="#26FFFFFF"
        android:pathData="M15.4,11 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0" />

</vector>
